#!/bin/sh
# UCI defaults for luci-app-modernui
# Runs once after package installation

# Set ModernUI as the default LuCI theme
uci -q set luci.main.mediaurlbase='/luci-static/modernui-app'
uci -q set luci.main.defaulttheme='modernui'

# Initialize modernui config if not present
uci -q get modernui.global || {
  uci set modernui.global='modernui'
  uci set modernui.global.theme='auto'
  uci set modernui.global.language='zh'
  uci set modernui.global.polling_interval='5'
  uci set modernui.global.sidebar_collapsed='0'
}

uci -q get modernui.dashboard || {
  uci set modernui.dashboard='dashboard'
  uci set modernui.dashboard.show_cpu='1'
  uci set modernui.dashboard.show_memory='1'
  uci set modernui.dashboard.show_temp='1'
  uci set modernui.dashboard.show_traffic='1'
  uci set modernui.dashboard.show_interfaces='1'
  uci set modernui.dashboard.show_dhcp='1'
}

uci commit modernui
uci commit luci

# Reload rpcd to register new ubus methods
/etc/init.d/rpcd reload 2>/dev/null || true

exit 0
